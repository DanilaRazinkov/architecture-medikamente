@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4: Контекст целевого состояния системы "Медикаменте" (To-Be)

Person(patient, "Пациент", "Субъект персональных данных. Использует портал и мобильное приложение.")
Person(doctor, "Врач", "Обрабатывает медицинские данные только назначенных пациентов.")
Person(admin, "Администратор", "Настраивает систему и политики безопасности.")

System_Boundary(med_system, "Целевая система 'Медикаменте'") {
    System(portal, "Пациентский портал / Мобильное приложение", "Позволяет записываться, просматривать свои данные, управлять согласиями.")
    System(core, "Ядро бизнес-системы", "EMR (Электронная медкарта), CRM, финансы, расписание.")
    System(privacy_layer, "**Privacy Layer**", "Централизованный слой управления конфиденциальностью: шифрование, доступ, аудит, согласия.")
    System(analytics_platform, "Аналитическая платформа", "Работает только с обезличенными данными из Data Lake.")
}

System_Ext(lab, "Лаборатория", "Внешняя система. Передает результаты анализов.")
System_Ext(payment_gw, "Платежный шлюз", "Обрабатывает финансовые транзакции.")
System_Ext(legacy_1c, "Унаследованные системы (1С)", "Бухгалтерия и склад. Интеграция через защищенные API.")

' Взаимодействия
Rel(patient, portal, "Использует для услуг и контроля своих данных", "HTTPS/TLS 1.3")
Rel(portal, privacy_layer, "Все запросы проходят проверку согласий и прав", "Внутренний API (gRPC/TLS)")
Rel(privacy_layer, core, "Доступ к данным только после успешной проверки", "Внутренний API")

Rel(doctor, core, "Работает с медкартами через защищенный интерфейс", "HTTPS + 2FA")
Rel(core, privacy_layer, "**Все операции логируются**, данные шифруются", "Асинхронные события, аудит-логи")

Rel(admin, privacy_layer, "Управляет политиками доступа и аудитом", "Привилегированный доступ, MFA")

Rel(analytics_platform, core, "Получает только обезличенные данные через ETL", "Защищенный канал, периодическая выгрузка")
Rel(analytics_platform, privacy_layer, "Регистрирует метаданные и lineage в каталоге", "Внутренний API")

Rel(lab, privacy_layer, "Передает результаты анализов по защищенному каналу", "API Gateway / HTTPS + mTLS")
Rel(payment_gw, privacy_layer, "Подтверждает платежи", "Webhook HTTPS")
Rel(privacy_layer, legacy_1c, "Синхронизирует только необходимые данные", "Защищенный коннектор (TLS, шифрование)")

note right of privacy_layer
  **Центр управления конфиденциальностью**
  Реализует принципы Privacy by Design:
  1. Проактивная защита
  2. Конфиденциальность по умолчанию
  3. Полная безопасность E2E
  4. Прозрачность (аудит)
  5. Контроль пользователя
end note
@enduml
